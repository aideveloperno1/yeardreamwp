# Copy this file to .env for local configuration.
# Add only the variable names agreed by the team.
# Never put real API keys or credentials in this example file.
# Model provider and runtime settings are not yet finalized.
ELICE_API_KEY=발급받은_Serverless_API_키
# api 예시 코드에 있는 https://mlapi.run 으로시작하는 주소에 /v1 붙이기
ELICE_BASE_URL=https://실제_엘리스_MLAPI_엔드포인트/v1
ELICE_MODEL=claude-haiku-5-5

OPIK_API_KEY=Opik Cloud에서 실제_발급받은_API_KEY
OPIK_EXPERIMENT_ID=최종 평가 실험 ID
OPIK_WORKSPACE=보내준 Opik 링크 기준.project01